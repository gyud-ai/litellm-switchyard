{
  // Copy to config.jsonc. Secrets and backend URLs stay in environment variables.
  "server": {"api_key": {"env": "GATEWAY_API_KEY"}, "host": "0.0.0.0", "port": 4000},
  "models": {
    "efficient": {
      "model_id": "your-efficient-model",
      "context_window": 131072,
      "defaults": {"reasoning_effort": "low"},
      "endpoints": [
        {"name": "efficient-a", "base_url": {"env": "EFFICIENT_API_BASE"},
         "api_key": {"env": "EFFICIENT_API_KEY"}},
        // Add replicas with unique labels, their own URL/key, and the same model_id.
      ],
    },
    "capable": {
      "model_id": "your-capable-model",
      "context_window": 1000000,
      "defaults": {"reasoning_effort": "high"},
      "endpoints": [
        {"name": "capable-a", "base_url": {"env": "CAPABLE_API_BASE"},
         "api_key": {"env": "CAPABLE_API_KEY"}},
      ],
    },
  },
  "pairs": {
    "switchyard": {"capable": "capable", "efficient": "efficient"},
    // Add arbitrary named pairs referencing existing or additional model definitions.
  },
  "stage": {
    "picker": "efficient_first",
    "confidence_threshold": 0.5,
    "recent_window": 3,
    "only_on_wrong_signal_escalation": true,
    "escalation_note": "The efficient tier failed; continue from its work.",
    "deescalation_note": "The capable tier completed the recovery.",
    "capable_system_prompt": "Handle this request as the capable tier.",
    "efficient_system_prompt": "Handle this request as the efficient tier.",
  },
  "compression": {"enabled": true, "workers": 2},
  "cooldown_seconds": 30.0,
  "connect_timeout": 5.0,
  "read_timeout": 300.0,
  "forward_headers": ["x-session-id", "x-opencode-session"],
}
