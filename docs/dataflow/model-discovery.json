  "graph": {
    "name": "Model Discovery"
  },
  "nodes": [
    {
      "id": "CLIENT",
      "description": "External HTTP caller (operator or OpenAI-compatible client) that sends the discovery request and receives the model list.",
      "group": 1,
      "role": "initiator"
    },
    {
      "id": "HTTP_SERVER",
      "symbol": "uvicorn.run",
      "description": "Single Uvicorn ASGI worker hosting the FastAPI app; accepts the connection and dispatches the request to the route.",
      "group": 7,
      "role": "intermediary"
    },
    {
      "id": "BOOTSTRAP",
      "symbol": "bootstrap.main",
      "description": "Composition root that parses CLI arguments, loads configuration, wires the Gateway, and starts the server.",
      "group": 7,
      "role": "intermediary"
    },
    {
      "id": "CONFIG_FILE",
      "description": "The untracked JSONC configuration document (default config.jsonc) that declares model and pair labels.",
      "group": 7,
      "role": "intermediary"
    },
    {
      "id": "LOAD_CONFIG",
      "symbol": "load_config",
      "description": "Config adapter that parses JSONC, resolves {env:...} references, validates references, and builds Settings.",
      "group": 4,
      "role": "intermediary"
    },
    {
      "id": "SETTINGS",
      "symbol": "Settings",
      "description": "Frozen gateway-owned Settings dataclass holding the models and pairs mappings consumed by discovery.",
      "group": 3,
      "role": "intermediary"
    },
    {
      "id": "GATEWAY",
      "symbol": "Gateway",
      "description": "Application-core Gateway object that owns the frozen settings used to answer discovery.",
      "group": 3,
      "role": "intermediary"
    },
    {
      "id": "MODELS_ROUTE",
      "symbol": "create_app.models",
      "description": "FastAPI GET /v1/models handler that authenticates the caller and serializes the alias list.",
      "group": 2,
      "role": "intermediary"
    },
    {
      "id": "AUTHORIZE",
      "symbol": "create_app.authorize",
      "description": "Ingress helper that compares the Authorization header to Bearer <api_key> with a constant-time digest.",
      "group": 2,
      "role": "intermediary"
    },
    {
      "id": "ERROR_RESPONSE",
      "symbol": "_error",
      "description": "Sanitized error response builder used only on the auth-failure branch.",
      "group": 2,
      "role": "intermediary"
    },
    {
      "id": "UUID4",
      "symbol": "uuid.uuid4",
      "description": "CPython standard-library source of the per-request id returned in the x-request-id header.",
      "group": 7,
      "role": "intermediary"
    },
    {
      "id": "EVENT_SINK",
      "symbol": "JsonEvents",
      "description": "JSON stdout event sink that the chat route emits to; never invoked by model discovery.",
      "group": 4,
      "role": "intermediary"
    }
  ],
