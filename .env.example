# Copy to .env and fill in. Never commit .env.
# Proxy auth + DB (required: compose fails fast if unset)
# NOTE: POSTGRES_PASSWORD must be URL-safe (letters, digits, _ - only).
# It is embedded into DATABASE_URL, so @ : / ? # % break Prisma (P1013).
LITELLM_MASTER_KEY=sk-CHANGE-ME
POSTGRES_PASSWORD=CHANGE-ME
LITELLM_PORT=4000

# Stage profile selector (default: stage)
SWITCHYARD_LITELLM_PROFILE=stage
# Pinned Switchyard checkout for the Docker builder (override if needed)
SWITCHYARD_REF=db9c9632e33686e6049d22722a5df2fb92cd62ef

# Efficient tier: cheap local OpenAI-compatible endpoint (you add later).
# MODEL_IDs are bare IDs; compose.yaml prepends the openai/ provider prefix.
CHEAP_API_BASE=http://host.docker.internal:11434/v1
CHEAP_API_KEY=dummy
CHEAP_MODEL_ID=local-model-id

# Capable tier: expensive cloud OpenAI-compatible endpoint (you add later)
EXPENSIVE_API_BASE=https://api.provider.com/v1
EXPENSIVE_API_KEY=sk-xxx
EXPENSIVE_MODEL_ID=frontier-model-id
