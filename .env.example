# Copy to .env and fill in. Never commit .env.

# Proxy auth + DB (required: Docker compose fails fast if unset)
# Used as the default password on LiteLLM UI and default API key for model
# endpoint
LITELLM_MASTER_KEY=sk-CHANGE-ME
# NOTE: POSTGRES_PASSWORD must be URL-safe (letters, digits, _ - only).
# It is embedded into DATABASE_URL, so @ : / ? # % break Prisma (P1013).
POSTGRES_PASSWORD=CHANGE-ME

# Host bind for the proxy. Loopback-only by default; set 0.0.0.0 (or a LAN IP)
# to serve the network — no TLS, master key is the only auth.
LITELLM_IP=127.0.0.1
LITELLM_PORT=4000

# Optional image overrides
# Defaults live in compose.yaml
# Version-pinned GHCR images published by .github/workflows/publish.yml.
# Uncomment to track latest or a specific build; use --build to compile locally
# instead.
# LITELLM_IMAGE=ghcr.io/gyud-ai/litellm-switchyard-proxy:latest
# HEADROOM_IMAGE=ghcr.io/gyud-ai/litellm-switchyard-headroom:latest

# Stage profile selector (default: stage)
SWITCHYARD_LITELLM_PROFILE=stage
# Pinned Switchyard checkout for the Docker builder (override if needed)
SWITCHYARD_REF=db9c9632e33686e6049d22722a5df2fb92cd62ef

# Model information
# API_BASE refers to the base URL for OpenAI-compatible endpoint.
# MODEL_ID refers to the bare IDs; compose.yaml prepends the openai/ provider
# prefix for LiteLLM.
# REASONING_EFFORT refers to reasoning depth - low, medium, high, xhigh, max.
# Note that not all models supports all depth settings and may only honor a
# subset.
# MAX_INPUT_TOKENS refers to the maximum token context length the model
# supports.
# MAX_OUTPUT_TOKENS refers to the maximum tokens outputted by a model for a
# single request.
# MODEL_TIMEOUT / MODEL_RETRIES tune per-tier network behavior.
#
# NOTE: capability flags (supports_reasoning, supports_function_calling,
# supports_vision) are NOT env-configurable — edit them directly in
# profiles/stage/litellm.yaml as literal true/false. Env values arrive as
# strings and the string "false" is truthy. Keep both tiers on the SAME
# capability set: Switchyard routes turns across tiers mid-conversation, so
# mismatched flags (e.g. tools on one tier but not the other) produce
# inconsistent behavior depending on which tier serves the turn.

# Efficient tier: cheaper cloud API or local OpenAI-compatible endpoint.
# (From inside the litellm container, host.docker.internal reaches the host;
# plain localhost would point at the container itself.)
CHEAP_API_BASE=http://host.docker.internal:11434/v1
CHEAP_API_KEY=sk-abc
CHEAP_MODEL_ID=local-model-id
CHEAP_REASONING_EFFORT=low
CHEAP_MAX_INPUT_TOKENS=131072
CHEAP_MAX_OUTPUT_TOKENS=32768
CHEAP_MODEL_TIMEOUT=300
CHEAP_MODEL_RETRIES=2

# Capable tier: more expensive cloud API or local OpenAI-compatible endpoint.
EXPENSIVE_API_BASE=https://api.provider.com/v1
EXPENSIVE_API_KEY=sk-xyz
EXPENSIVE_MODEL_ID=frontier-model-id
EXPENSIVE_REASONING_EFFORT=max
EXPENSIVE_MAX_INPUT_TOKENS=1048576
EXPENSIVE_MAX_OUTPUT_TOKENS=262144
EXPENSIVE_MODEL_TIMEOUT=300
EXPENSIVE_MODEL_RETRIES=2

# Headroom compression sidecar (pre_call guardrail, single instance).
# LiteLLM POSTs {messages, model} to HEADROOM_API_BASE/v1/compress, then calls
# the backends above directly. No api_base rewiring needed.
# HEADROOM_API_BASE is fixed internally (http://headroom:8787); only the host
# loopback stats port and log level are configurable here.
HEADROOM_PORT=8788
HEADROOM_LOG_LEVEL=warning

# "true" = compress every request on both tiers by default; "false" (keep) =
# opt-in per request ({"guardrails": ["headroom-compression"]}) or per key.
# Must be exactly true/false (never empty); needs `docker compose up -d`
# to take effect (config is re-read on recreate, not per request).
HEADROOM_DEFAULT_ON=false
