# Headroom compression sidecar, called by LiteLLM via the `headroom-compression`
# pre_call guardrail (POST {api_base}/v1/compress). Pinned per
# https://docs.litellm.ai/docs/proxy/headroom (headroom-ai[proxy]==0.27.0,
# python:3.13-slim). Runtime behavior (remote access, user-message compression,
# telemetry) is set in compose.yaml, not here, so the image stays stock.
FROM python:3.13-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && pip install --no-cache-dir "headroom-ai[proxy]==0.27.0" \
    && apt-get purge -y build-essential \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*
EXPOSE 8787
ENV HEADROOM_TELEMETRY=off
CMD ["headroom", "proxy", "--host", "0.0.0.0", "--port", "8787"]
